PORT=3000
APP_PORT=3001
CUSTOM_PROVIDER_DOMAINS=example.com,catalogo.com.uy
POSTGRES_DB=repuestos_uy
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/repuestos_uy
JOB_WORKERS=2
JOB_POLL_INTERVAL_MS=1000
DOMAIN_EXTRACT_CONCURRENCY=4
AUTO_SCRAPE_ENABLED=false
SCRAPE_CRON=0 0 3 * * *
SCRAPE_TIMEZONE=America/Argentina/Buenos_Aires
YOKOMITSU_USERNAME=
YOKOMITSU_PASSWORD=
IMAGE_RELAY_ENABLED=false
IMAGE_RELAY_ALLOWED_SITES=selvir.com.uy,acesur.uy,chaparei.com
IMAGE_STORAGE_ROOT=/data/images
IMAGE_MAX_BYTES=10485760
IMAGE_RETRY_LIMIT=3
IMAGE_WORKER_TOKEN=change-me
